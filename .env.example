# =====================================================================
# Configuración del servidor SOTIRIA
# Copia este archivo como ".env" (en esta misma carpeta) y complétalo.
# El archivo .env NO se sube a GitHub. Nunca pongas tokens en el código.
# Guía paso a paso: WHATSAPP.md
# =====================================================================

# Puerto del servidor
PORT=3000

# Dirección pública HTTPS donde está publicada la web (sin "/" al final).
# Se usa en los enlaces de las entradas que llegan por WhatsApp.
PUBLIC_BASE_URL=https://tu-dominio.com

# ---------------------------------------------------------------------
# WhatsApp
#   simulator → sin WhatsApp real; se prueba en el panel (pestaña Simulador)
#   cloud     → WhatsApp real con la Cloud API oficial de Meta
# ---------------------------------------------------------------------
WHATSAPP_MODE=simulator

# Meta → tu app → WhatsApp → Configuración de la API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# Texto que inventas tú (largo y difícil). Se escribe IGUAL en Meta → WhatsApp → Configuración → Webhook
WHATSAPP_VERIFY_TOKEN=

# Versión de la API que muestra Meta en sus ejemplos (formato vNN.N)
WHATSAPP_GRAPH_VERSION=v23.0

# Meta → tu app → Configuración de la app → Básica → Clave secreta de la app
META_APP_SECRET=

# Número comercial (código de país + número, sin "+" ni espacios).
# Debe coincidir con CONTACT.whatsapp en js/data.js
WHATSAPP_BUSINESS_NUMBER=59177314953

# ---------------------------------------------------------------------
# Contraseñas del panel (opcional: si no se ponen, se usan las de
# server/admin.json y server/validator.json)
# ---------------------------------------------------------------------
# ADMIN_PASSWORD=
# VALIDATOR_PASSWORD=
